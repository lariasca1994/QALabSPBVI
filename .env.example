# Pagos y autenticacion: base PostgreSQL nueva y exclusiva de QALabSPBVI; no reutilizar datos existentes.
# Formato: postgresql+psycopg://usuario:clave@localhost:5432/qalabspbvi_app
# Sin PostgreSQL disponible se permite SQLite temporal (valor por defecto abajo).
DATABASE_URL=sqlite:///./qalab.db

# Base nueva y exclusiva de DIFE en SQL Server (no reutilizar otras bases).
# Formato SQLAlchemy: mssql+pyodbc://usuario:clave@servidor/QALabDIFE?driver=ODBC+Driver+18+for+SQL+Server
# Con autenticacion de Windows (solo local): mssql+pyodbc://@localhost/QALabDIFE?driver=ODBC+Driver+18+for+SQL+Server&trusted_connection=yes&TrustServerCertificate=yes
DIFE_DATABASE_URL=
# Usuario/esquema Oracle nuevo y exclusivo de DICE en FREEPDB1.
# Formato SQLAlchemy: oracle+oracledb://usuario:clave@localhost:1521/?service_name=freepdb1
DICE_DATABASE_URL=

APP_ENV=local
MONGODB_URL=mongodb://127.0.0.1:27017
# Base local nueva y dedicada a QA; no apuntar a cluster0 ni a datos de otros proyectos.
MONGODB_DATABASE=qalabspbvi_qa
QA_TARGET_BASE_URL=http://127.0.0.1:8000

# Genera una clave local privada con:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
# Copia el resultado solo en .env; nunca en este archivo ni en Git.
# AUTH_SECRET_KEY debe tener al menos 32 caracteres para habilitar MFA.
AUTH_SECRET_KEY=

# Brevo API para MFA y notificaciones. Guarda la clave solo en .env.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=QALabSPBVI

# Referencia opcional desde un CP con {{secret:PAYMENTS_API_TOKEN}}.
# Guarda cualquier valor real solo en .env; no lo subas a Git.
QA_SECRET_PAYMENTS_API_TOKEN=
