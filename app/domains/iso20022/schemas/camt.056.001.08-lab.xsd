            <xs:element name="OrgnlEndToEndId" type="Max100Text"/>
            <xs:element name="OrgnlIntrBkSttlmAmt" type="Amount"/>
            <xs:element name="CxlRsnInf"><xs:complexType><xs:sequence><xs:element name="Rsn"><xs:complexType><xs:sequence><xs:element name="Cd"><xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="AC03"/><xs:enumeration value="AM09"/><xs:enumeration value="CUST"/><xs:enumeration value="DUPL"/><xs:enumeration value="FRAD"/><xs:enumeration value="TECH"/><xs:enumeration value="UPAY"/></xs:restriction></xs:simpleType></xs:element></xs:sequence></xs:complexType></xs:element></xs:sequence></xs:complexType></xs:element>
          </xs:sequence></xs:complexType></xs:element>
        </xs:sequence></xs:complexType></xs:element>
      </xs:sequence></xs:complexType>
    </xs:element></xs:sequence></xs:complexType>
  </xs:element>
</xs:schema>
